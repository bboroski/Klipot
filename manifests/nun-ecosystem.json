{
  "schema_version": "nun.ecosystem.v1",
  "system": {
    "id": "nun",
    "name": "NUN",
    "contract_version": "1.0.0",
    "description": "Independent repositories coordinated by versioned contracts and explicit adapters."
  },
  "components": [
    {
      "id": "kloz",
      "repo": "bboroski/Kloz",
      "role": "machine-near C11 foundation",
      "depends_on": [],
      "provides": [
        "platform.contract.v1",
        "platform.clock.monotonic.v1",
        "resource.budget.fixed.v1"
      ],
      "requires": [],
      "integration_status": "implemented"
    },
    {
      "id": "co",
      "repo": "bboroski/CO",
      "role": "deterministic lifecycle control",
      "depends_on": [
        "kloz"
      ],
      "provides": [
        "lifecycle.control.v1"
      ],
      "requires": [
        "platform.contract.v1"
      ],
      "integration_status": "contract-defined"
    },
    {
      "id": "saintsi",
      "repo": "bboroski/SaintSI",
      "role": "health and integrity observations",
      "depends_on": [
        "kloz"
      ],
      "provides": [
        "health.monitor.v1",
        "integrity.crc32.v1"
      ],
      "requires": [
        "platform.clock.monotonic.v1"
      ],
      "integration_status": "contract-defined"
    },
    {
      "id": "reapercripple",
      "repo": "bboroski/ReaperCripple",
      "role": "embedded manufacturing and lifecycle engineering",
      "depends_on": [
        "kloz",
        "co",
        "saintsi"
      ],
      "provides": [
        "embedded.manufacturing.v1",
        "bsp.supervision.v1"
      ],
      "requires": [
        "platform.contract.v1",
        "resource.budget.fixed.v1",
        "lifecycle.control.v1",
        "health.monitor.v1"
      ],
      "integration_status": "adapter-validation-required"
    },
    {
      "id": "sambu",
      "repo": "bboroski/SAMBU",
      "role": "language, DSL and declarative policy authoring",
      "depends_on": [],
      "provides": [
        "policy.schema.v1",
        "workflow.authoring.v1"
      ],
      "requires": [],
      "integration_status": "policy-contract-proposed"
    },
    {
      "id": "toolng",
      "repo": "bboroski/ToolNG",
      "role": "local Windows diagnostics",
      "depends_on": [
        "sambu"
      ],
      "provides": [
        "local.diagnostics.evidence.v1"
      ],
      "requires": [
        "policy.schema.v1"
      ],
      "integration_status": "portable-policy-adaptation"
    },
    {
      "id": "klipot",
      "repo": "bboroski/Klipot",
      "role": "ecosystem integration control plane",
      "depends_on": [
        "reapercripple",
        "toolng"
      ],
      "provides": [
        "ecosystem.orchestration.plan.v1"
      ],
      "requires": [
        "embedded.manufacturing.v1",
        "local.diagnostics.evidence.v1"
      ],
      "integration_status": "manifest-planner-v0.1"
    },
    {
      "id": "nun-os-kernel",
      "repo": "bboroski/NUN",
      "role": "x86-64 bare-metal operating-system kernel and boot foundation",
      "depends_on": [
        "kloz",
        "co",
        "saintsi",
        "reapercripple"
      ],
      "provides": [
        "kernel.boot.handoff.v1",
        "kernel.serial.diagnostics.v1",
        "kernel.framebuffer.marker.v1",
        "kernel.physical-page-allocator.v1",
        "nun.system.foundation.v1"
      ],
      "requires": [
        "limine.boot.protocol.v1",
        "x86_64.platform.abi.v1"
      ],
      "integration_status": "early-boot-foundation-implemented; user-space-and-device-subsystems-pending"
    },
    {
      "id": "nunlauncher-android-home",
      "repo": "bboroski/NUNLauncher",
      "role": "Android HOME launcher and local application catalog",
      "depends_on": [],
      "provides": [
        "android.home.launcher.v1",
        "android.launcherapps.catalog.v1",
        "android.launcherapps.search.v1",
        "android.launcherapps.dispatch.v1"
      ],
      "requires": [
        "android.launcherapps.api"
      ],
      "integration_status": "android-home-foundation-implemented; authenticated-NUN-bridge-planned"
    }
  ]
}
