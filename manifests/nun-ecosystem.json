{
  "schema_version": "nun.ecosystem.v1",
  "system": {
    "id": "nun",
    "name": "NUN",
    "contract_version": "1.0.0",
    "description": "Eleven independent repositories coordinated through versioned contracts, explicit capability declarations, and evidence-gated uncertainty resolution."
  },
  "components": [
    {
      "id": "co",
      "repo": "bboroski/CO",
      "role": "deterministic lifecycle control",
      "depends_on": [
        "kloz"
      ],
      "provides": [
        "lifecycle.control.v1"
      ],
      "requires": [
        "platform.contract.v1"
      ],
      "integration_status": "contract-defined"
    },
    {
      "id": "fragile-baby",
      "repo": "bboroski/Fragile-Baby",
      "role": "Elbrus E2K target qualification gates",
      "depends_on": [],
      "provides": [
        "elbrus.target.profile.v1",
        "elbrus.qualification.gates.v1"
      ],
      "requires": [],
      "integration_status": "host-qualification-contract-target-unqualified"
    },
    {
      "id": "klipot",
      "repo": "bboroski/Klipot",
      "role": "ecosystem integration control plane",
      "depends_on": [
        "reapercripple",
        "toolng"
      ],
      "provides": [
        "ecosystem.orchestration.plan.v1",
        "uncertainty.workspace-plan.v1"
      ],
      "requires": [
        "embedded.manufacturing.v1",
        "local.diagnostics.evidence.v1"
      ],
      "integration_status": "manifest-planner-v0.1"
    },
    {
      "id": "kloz",
      "repo": "bboroski/Kloz",
      "role": "machine-near C11 foundation",
      "depends_on": [],
      "provides": [
        "platform.contract.v1",
        "platform.clock.monotonic.v1",
        "resource.budget.fixed.v1",
        "platform.capability.query.four-state.v1"
      ],
      "requires": [],
      "integration_status": "implemented"
    },
    {
      "id": "luci",
      "repo": "bboroski/Luci",
      "role": "offline repository evidence and feature-gap audit",
      "depends_on": [],
      "provides": [
        "workspace.evidence.audit.v1",
        "workspace.feature.gap.plan.v1"
      ],
      "requires": [],
      "integration_status": "early-python-implementation"
    },
    {
      "id": "nun",
      "repo": "bboroski/NUN",
      "role": "minimal operating-system kernel specification",
      "depends_on": [],
      "provides": [
        "kernel.architecture.specification.v1",
        "kernel.boot-info.validation.host.v1"
      ],
      "requires": [],
      "integration_status": "host-contract-implemented-kernel-not-bootable"
    },
    {
      "id": "nunlauncher",
      "repo": "bboroski/NUNLauncher",
      "role": "kernel bootstrap and handoff specification",
      "depends_on": [
        "nun"
      ],
      "provides": [
        "kernel.bootstrap.specification.v1",
        "kernel.image.validation.host.v1",
        "kernel.handoff.metadata.host.v1"
      ],
      "requires": [
        "kernel.architecture.specification.v1"
      ],
      "integration_status": "host-contract-implemented-no-cpu-transfer"
    },
    {
      "id": "reapercripple",
      "repo": "bboroski/ReaperCripple",
      "role": "embedded manufacturing and lifecycle engineering",
      "depends_on": [
        "kloz",
        "co",
        "saintsi"
      ],
      "provides": [
        "embedded.manufacturing.v1",
        "bsp.supervision.v1"
      ],
      "requires": [
        "platform.contract.v1",
        "resource.budget.fixed.v1",
        "lifecycle.control.v1",
        "health.monitor.v1"
      ],
      "integration_status": "adapter-validation-required"
    },
    {
      "id": "saintsi",
      "repo": "bboroski/SaintSI",
      "role": "health and integrity observations",
      "depends_on": [
        "kloz"
      ],
      "provides": [
        "health.monitor.v1",
        "integrity.crc32.v1",
        "health.coverage.unknown.v1"
      ],
      "requires": [
        "platform.clock.monotonic.v1"
      ],
      "integration_status": "contract-defined"
    },
    {
      "id": "sambu",
      "repo": "bboroski/SAMBU",
      "role": "language, DSL and declarative policy authoring",
      "depends_on": [],
      "provides": [
        "policy.schema.v1",
        "workflow.authoring.v1"
      ],
      "requires": [],
      "integration_status": "policy-contract-proposed"
    },
    {
      "id": "toolng",
      "repo": "bboroski/ToolNG",
      "role": "local Windows diagnostics",
      "depends_on": [
        "sambu"
      ],
      "provides": [
        "local.diagnostics.evidence.v1"
      ],
      "requires": [
        "policy.schema.v1"
      ],
      "integration_status": "portable-policy-adaptation"
    }
  ]
}