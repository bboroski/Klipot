{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bboroski/Klipot/blob/main/schemas/ecosystem-manifest.schema.json",
  "title": "NUN Ecosystem Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system", "components"],
  "properties": {
    "schema_version": {"const": "nun.ecosystem.v1"},
    "system": {
      "type": "object",
      "required": ["id", "name", "contract_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "component.schema.json"}
    }
  }
}
