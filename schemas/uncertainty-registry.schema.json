{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bboroski/Klipot/blob/main/schemas/uncertainty-registry.schema.json",
  "title": "Klipot Uncertainty Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "items"],
  "properties": {
    "schema_version": {"const": "klipot.uncertainty.v1"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "statement", "feature", "resolution_mode", "unknown_behavior", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "feature": {"type": "string", "minLength": 1},
          "resolution_mode": {
            "enum": ["probe", "explicit-config", "human-gate", "fail-closed", "staged-implementation", "feature-flag"]
          },
          "unknown_behavior": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "resolved", "blocked"], "default": "open"},
          "implementation_status": {"enum": ["planned", "implemented", "verified"], "default": "planned"},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
