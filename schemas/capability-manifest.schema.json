{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bboroski/Klipot/blob/main/schemas/capability-manifest.schema.json",
  "title": "NUN Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component", "provides", "requires", "execution"],
  "properties": {
    "schema_version": {"const": "nun.capability.v1"},
    "component": {
      "type": "object",
      "required": ["id", "repo", "version", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repo": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provides": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requires": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resource_profile": {"$ref": "resource-profile.schema.json"},
    "execution": {"enum": ["synchronous", "cooperative", "process-isolated", "wasm-isolated", "remote"]},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
